{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "lastChangelogVersion": "1.4.0",
  "defaultProvider": "mistral",
  "defaultModel": "mistral-large-4",
  "theme": "gruvbox-material-light",
  "defaultThinkingLevel": "high",
  "hideThinkingBlock": false,
  "externalEditor": "nvim",
  "defaultProjectTrust": "always",
  "quietStartup": true,
  "enableInstallTelemetry": false,
  "defaultTools": ["+codemode"],
  "cacheWarming": "idle",
  "markdown": {
    "mermaid": "streaming"
  },
  "tuiMode": "fullscreen",
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "packages": [
    "npm:pi-web-access@0.45.0",
    "npm:pi-vision-handoff@0.10.11",
    "npm:pi-agent-browser-native@0.9.6",
    "npm:pi-hermes-memory@0.9.11",
    "npm:@narumitw/pi-lsp@0.49.10",
    "npm:pi-subagents@0.83.1",
    "npm:@narumitw/pi-goal@0.54.13"
  ]
}
